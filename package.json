{
  "name": "accountant-rpa",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm --workspace api run dev",
    "dev:web": "npm --workspace web run dev",
    "dev:desktop": "npm --workspace desktop run dev",
    "build": "npm run build --workspace web && npm run build --workspace api",
    "build:desktop": "npm run build:main --workspace desktop",
    "start": "npm run start --workspace api",
    "seed": "npm run seed --workspace api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
